;; Operations on constants run with IEEE 754 arithmetic, like any other
;; operation: Go's constant evaluator (exact arithmetic, no negative zero,
;; and compile errors for overflow and division by zero) never sees them.
(module
  (func (export "zero_times_minus_one") (result f64)
    (f64.mul (f64.const 0) (f64.const -1)))
  (func (export "tiny_times_minus_tiny") (result f64)
    (f64.mul (f64.const 1e-300) (f64.const -1e-300)))
  (func (export "div_by_zero") (param f64) (result f64)
    (f64.div (local.get 0) (f64.const 0)))
  (func (export "one_div_zero") (result f64)
    (f64.div (f64.const 1) (f64.const 0)))
  (func (export "zero_div_zero") (result f64)
    (f64.div (f64.const 0) (f64.const 0)))
  (func (export "overflow") (result f64)
    (f64.mul (f64.const 1e308) (f64.const 10)))
  (func (export "rounded_product") (result f64)
    (f64.add (f64.mul (f64.const 0x1.00000004p+0) (f64.const 0x1.fffffff8p-1)) (f64.const -1)))
  (func (export "minus_zero_sum") (result f64)
    (f64.add (f64.const -0) (f64.const -0)))
  (func (export "zero_times_minus_one32") (result f32)
    (f32.mul (f32.const 0) (f32.const -1)))
  (func (export "overflow32") (result f32)
    (f32.mul (f32.const 3e38) (f32.const 10)))
  (func (export "div_by_zero32") (param f32) (result f32)
    (f32.div (local.get 0) (f32.const 0)))
  (func (export "third32") (result f32)
    (f32.div (f32.const 1) (f32.const 3)))
)
